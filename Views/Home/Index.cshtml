@{
    ViewData["Title"] = "Personality Test";
}

<div class="container text-center mt-4">
    <h1>🧠 Personality Test</h1>
    <p class="lead">Look at the images below and click the <strong>first one</strong> that catches your eye!</p>

    <form asp-action="Result" method="post">
        <div class="row mt-4">
            <div class="col-md-3 mb-3">
                <button type="submit" name="selectedImage" value="image1" class="btn p-0 border-0">
                    <img src="~/images/image1.jpg" class="img-fluid rounded shadow"
                         style="width:100%; height:200px; object-fit:cover;" />
                    <p class="mt-2">Image 1</p>
                </button>
            </div>
