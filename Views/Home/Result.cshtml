@{
    ViewData["Title"] = "Your Personality Result";
}

<div class="container text-center mt-5">
    <h1>🎯 Your Personality Result</h1>

    <div class="card mx-auto mt-4 shadow" style="max-width:500px;">
        <div class="card-body">
            <img src="~/images/@(ViewBag.SelectedImage).jpg"
                 class="img-fluid rounded mb-3"
                 style="max-height:200px; object-fit:cover;" />
            <h3 class="card-title">@ViewBag.Personality</h3>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-primary mt-4">Take Test Again</a>
</div>
